// ==================== MASTER ORCHESTRATOR (DEFAULT FUNCTION) ====================
function setupAllLMSSheets() {
  const res1 = setupResultTrackingSheets();
  const res2 = populateCurriculumSheets();
  const res3 = populateChangelogSheet();
